[Unit]
Description=Process the PPSV durable mail outbox
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/shiny-server/ppsvf-app/process_mail_outbox.R

[Service]
Type=oneshot
User=ppsvf-shiny-user
Group=ppsvf-shiny
EnvironmentFile=/etc/ppsvf-app/ppsvf-app.env
Environment=PPSV_ENV_PRELOADED=1
WorkingDirectory=/srv/shiny-server/ppsvf-app
ExecStart=/usr/local/libexec/ppsvf-app/process_mail_outbox.sh
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
