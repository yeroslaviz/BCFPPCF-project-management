# Copy to /etc/ppsvf-app/ppsvf-app.env, replace every required placeholder,
# then set owner root:root and mode 0600. Never commit the real file.

# Application identity and public address
AUTH_MODE=ldap
TRUST_PROXY_AUTH_USER_QUERY=1
PPSV_PUBLIC_URL=https://ppcf-vm.biochem.mpg.de/ppsvf-app/

# Server-side profile lookup, matching NGS. Apache supplies the authenticated
# uid; the app reads name/email/phone/group directly from LDAP. ou is the
# research group/PI identifier, while cn is the user's full name.
LDAP_URI=ldaps://ldapserv1.biochem.mpg.de,ldaps://ldapserv2.biochem.mpg.de,ldaps://ldapserv3.biochem.mpg.de
LDAP_BASE_DN=dc=biochem,dc=mpg,dc=de
LDAP_ATTR_UID=uid
LDAP_ATTR_MAIL=mail
LDAP_ATTR_PHONE=telephoneNumber
LDAP_ATTR_OU=ou
LDAP_ATTR_CN=cn
LDAP_ATTR_GIVENNAME=givenName
LDAP_ATTR_SN=sn
# Leave both blank for anonymous profile searches. If required, use a read-only
# service account; do not use the requester's login password.
LDAP_BIND_DN=
LDAP_BIND_PW=
LDAPSEARCH_PATH=ldapsearch
# Per-directory search limit; unreachable servers fall through to the next URI.
LDAP_TIMEOUT_SECONDS=3
# Shiny's login-style launcher may drop EnvironmentFile overrides. For
# nondefault LDAP values, also set them in the runtime user's private
# /home/ppsvf-shiny-user/.Renviron (mode 0600) after provisioning.

# Billing catalogue defaults to budget_holders.csv in the application folder.
# Set an override only if the catalogue is managed outside the release.
# PPSV_BUDGET_HOLDERS_FILE=/absolute/path/to/budget_holders.csv

# Persistent state
PPSV_DB_FILE=/srv/ppsv-app-data/database/ppsv_projects.db
PPSV_POOL_ROOT=/fs/pool/pool-ppsvf-projects
PPSV_FALLBACK_ROOT=/srv/ppsv-app-data/uploads_pending_pool
PPSV_MAX_UPLOAD_MB=75
# Record the reviewed `findmnt -n -o SOURCE -T "$PPSV_POOL_ROOT"` value.
# A local directory is accepted only on an explicit test VM.
PPSV_POOL_EXPECTED_SOURCE=REQUIRED_FACILITY_POOL_MOUNT_SOURCE
PPSV_ALLOW_LOCAL_POOL=0

# Runtime and deployment identities
APP_RUN_USER=ppsvf-shiny-user
APP_RUN_GROUP=b_profa
PPSV_POOL_GROUP=b_profa
PPSV_RELEASES_ROOT=/srv/ppsvf-app/releases
PPSV_DATA_ROOT=/srv/ppsv-app-data
PPSV_CURRENT_LINK=/srv/shiny-server/ppsvf-app
# PPSV alone uses this side-by-side R installation; /usr/bin/R may remain 4.5.
PPSV_R_BIN=/opt/R/4.6.1/bin

# Ticket delivery. Keep service_reply_to until the end-to-end ldap_from test
# proves that the relay accepts the LDAP address and the ticket auto-reply
# reaches that same user. Use disabled on non-mail test hosts.
PPSV_TICKET_TO=ppsv-request@biochem.mpg.de
PPSV_MAIL_FROM=ppsv-service@biochem.mpg.de
PPSV_TICKET_MODE=service_reply_to
PPSV_DIRECT_ACK=true
PPSV_SMTP_HOST=msx.biochem.mpg.de
PPSV_SMTP_PORT=25
PPSV_SMTP_SECURITY=none
PPSV_SMTP_USER=
PPSV_SMTP_PASSWORD=
# Operator alerts are independent of the request/ticket outbox. Confirm that
# this relay also accepts the service sender and delivers to this address.
PPSV_ALERT_TO=omicsdesk@biochem.mpg.de
# Human-controlled production gates. Set only after the service identity is
# authorized and the documented requester/auto-reply end-to-end test passes.
PPSV_SERVICE_IDENTITY_AUTHORIZED_ACK=0
PPSV_TICKET_E2E_TEST_ACK=0

# TLS source files used only by scripts/provision.sh. The private key is
# intentionally blank: an operator must supply the exact matching file.
TLS_CERT_FILE=/etc/ssh/2027_ppcf-vm.pem
TLS_BUNDLE_FILE=/etc/ssh/2027_ppcf-vm_bundle.pem
TLS_KEY_FILE=

# Weekly local recovery copies. This is on the same VM, not off-host disaster
# recovery; arrange a separate VM/filesystem backup with infrastructure staff.
PPSV_BACKUP_DIR=/srv/ppsv-app-data/db-backups
PPSV_BACKUP_RETENTION_DAYS=30
PPSV_ALLOW_LOCAL_BACKUP=1
PPSV_BACKUP_EXPECTED_SOURCE=
# backup.sh protects SQLite and fallback uploads, not the facility pool. Change
# this only after the external pool snapshot/retention/restore policy is owned.
PPSV_POOL_SNAPSHOT_POLICY_ACK=0

# Shiny Server Open Source binary gate. Installation is deliberately separate:
# supply the downloaded .deb and its independently reviewed SHA-256 to
# scripts/install_shiny_server.sh.
SHINY_SERVER_VERSION=1.5.23.1030
# Reviewed 2026-09-25 against the official Posit artifact documented at
# https://download3.rstudio.org/ubuntu-20.04/x86_64/shiny-server-1.5.23.1030-amd64.deb
SHINY_SERVER_DEB_SHA256=4a3d063a06ccd1b6c53eb1d7f4fb59965bced10d1c5c87e8c476b58dd6fd35ee
