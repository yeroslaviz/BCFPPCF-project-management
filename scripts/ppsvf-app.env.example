# Copy to /etc/ppsvf-app/ppsvf-app.env, replace every required placeholder,
# then set owner root:ppsvf-shiny and mode 0640. Never commit the real file.

# Application identity and public address
AUTH_MODE=ldap
PPSV_PUBLIC_URL=https://ppcf-vm.biochem.mpg.de/ppsvf-app/

# Persistent state
PPSV_DB_FILE=/srv/ppsvf-app-data/ppsv_projects.db
PPSV_POOL_ROOT=/fs/pool/pool-ppsvf-projects
PPSV_FALLBACK_ROOT=/srv/ppsvf-app-data/uploads_pending_pool
PPSV_MAX_UPLOAD_MB=75
# Record the reviewed `findmnt -n -o SOURCE -T "$PPSV_POOL_ROOT"` value.
# A local directory is accepted only on an explicit test VM.
PPSV_POOL_EXPECTED_SOURCE=REQUIRED_FACILITY_POOL_MOUNT_SOURCE
PPSV_ALLOW_LOCAL_POOL=0

# Runtime and deployment identities
APP_RUN_USER=ppsvf-shiny-user
APP_RUN_GROUP=ppsvf-shiny
PPSV_POOL_GROUP=b_profa
PPSV_RELEASES_ROOT=/srv/ppsvf-app/releases
PPSV_DATA_ROOT=/srv/ppsvf-app-data
PPSV_CURRENT_LINK=/srv/shiny-server/ppsvf-app

# Ticket delivery. Keep service_reply_to until the end-to-end ldap_from test
# proves that the relay accepts the LDAP address and the ticket auto-reply
# reaches that same user. Use disabled on non-mail test hosts.
PPSV_TICKET_TO=ppsv-request@biochem.mpg.de
PPSV_MAIL_FROM=ppsv-service@biochem.mpg.de
PPSV_TICKET_MODE=service_reply_to
PPSV_DIRECT_ACK=true
PPSV_SMTP_HOST=REQUIRED_SMTP_HOST
PPSV_SMTP_PORT=587
PPSV_SMTP_SECURITY=starttls
PPSV_SMTP_USER=REQUIRED_SMTP_USER
PPSV_SMTP_PASSWORD=REQUIRED_SMTP_PASSWORD
# Human-controlled production gates. Set only after the service identity is
# authorized and the documented requester/auto-reply end-to-end test passes.
PPSV_SERVICE_IDENTITY_AUTHORIZED_ACK=0
PPSV_TICKET_E2E_TEST_ACK=0

# TLS source files used only by scripts/provision.sh. The private key is
# intentionally blank: an operator must supply the exact matching file.
TLS_CERT_FILE=/etc/ssh/2027_ppcf-vm.pem
TLS_BUNDLE_FILE=/etc/ssh/2027_ppcf-vm_bundle.pem
TLS_KEY_FILE=

# Must be an external mounted destination. Local-root storage is rejected
# unless PPSV_ALLOW_LOCAL_BACKUP=1 is explicitly accepted for a test VM.
PPSV_BACKUP_DIR=REQUIRED_EXTERNAL_BACKUP_DIRECTORY
PPSV_BACKUP_RETENTION_DAYS=30
PPSV_ALLOW_LOCAL_BACKUP=0
# Record the reviewed `findmnt -n -o SOURCE -T "$PPSV_BACKUP_DIR"` value.
# The nightly job refuses a different/missing mount instead of filling local disk.
PPSV_BACKUP_EXPECTED_SOURCE=REQUIRED_EXTERNAL_MOUNT_SOURCE
# backup.sh protects SQLite and fallback uploads, not the facility pool. Change
# this only after the external pool snapshot/retention/restore policy is owned.
PPSV_POOL_SNAPSHOT_POLICY_ACK=0

# Shiny Server Open Source binary gate. Installation is deliberately separate:
# supply the downloaded .deb and its independently reviewed SHA-256 to
# scripts/install_shiny_server.sh.
SHINY_SERVER_VERSION=1.5.23.1030
# Reviewed 2026-09-25 against the official Posit artifact documented at
# https://download3.rstudio.org/ubuntu-20.04/x86_64/shiny-server-1.5.23.1030-amd64.deb
SHINY_SERVER_DEB_SHA256=4a3d063a06ccd1b6c53eb1d7f4fb59965bced10d1c5c87e8c476b58dd6fd35ee
